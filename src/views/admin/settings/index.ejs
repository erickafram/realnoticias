<%- include('../layouts/main', { body: `
<div class="page-header">
  <div>
    <h1>Configurações</h1>
    <p>Personalize seu portal</p>
  </div>
</div>

<!-- Navegação por Abas -->
<div class="settings-tabs">
  <button class="tab-btn active" data-tab="geral"><i class="bi bi-sliders"></i> Geral</button>
  <button class="tab-btn" data-tab="aparencia"><i class="bi bi-palette"></i> Aparência</button>
  <button class="tab-btn" data-tab="seo"><i class="bi bi-search"></i> SEO</button>
  <button class="tab-btn" data-tab="anuncios"><i class="bi bi-megaphone"></i> Anúncios</button>
  <button class="tab-btn" data-tab="codigo"><i class="bi bi-code-slash"></i> Código</button>
</div>

<!-- Logo do Site (fora do form principal) -->
<div class="settings-card logo-card" style="margin-bottom: 20px;">
  <div class="card-header">
    <i class="bi bi-image"></i>
    <span>Logo do Site</span>
  </div>
  <div class="card-body">
    <div class="logo-preview-area">
      ${groupedSettings.general?.find(s => s.key === 'site_logo')?.value 
        ? '<div class="logo-current"><img src="' + groupedSettings.general.find(s => s.key === 'site_logo').value + '" alt="Logo atual"><div class="logo-actions"><form action="/admin/settings/remove-logo" method="POST" class="logo-remove-form"><button type="submit" class="btn-remove-logo" onclick="return confirmRemoveLogo();"><i class="bi bi-trash"></i> Remover</button></form></div></div>'
        : '<div class="logo-placeholder"><i class="bi bi-image"></i><span>Nenhuma logo</span></div>'
      }
    </div>
    <form action="/admin/settings/upload-logo" method="POST" enctype="multipart/form-data" class="logo-upload-form">
      <div class="upload-area" id="logoDropArea">
        <input type="file" name="logo" id="logoInput" accept="image/*" hidden>
        <div class="upload-content">
          <i class="bi bi-cloud-arrow-up"></i>
          <span>Arraste ou <label for="logoInput" class="upload-link">selecione</label></span>
        </div>
      </div>
      <div class="upload-preview" id="logoPreview" style="display: none;">
        <img id="logoPreviewImg" src="" alt="Preview">
        <button type="button" class="btn-clear-preview" onclick="clearLogoPreview()"><i class="bi bi-x"></i></button>
      </div>
      <button type="submit" class="btn-upload-logo" id="btnUploadLogo" disabled><i class="bi bi-upload"></i> Enviar</button>
    </form>
  </div>
</div>

<form action="/admin/settings" method="POST">
<div class="settings-container">
  <!-- ==================== ABA GERAL ==================== -->
  <div class="tab-content active" id="tab-geral">
    <div class="settings-grid">
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-gear"></i><span>Informações do Site</span></div>
        <div class="card-body">
          ${groupedSettings.general ? groupedSettings.general.filter(s => s.key !== 'site_logo').map(s => 
            '<div class="form-group"><label>' + (s.label || s.key) + '</label>' +
            (s.type === 'textarea' ? '<textarea name="' + s.key + '" rows="2">' + (s.value || '') + '</textarea>' : '<input type="text" name="' + s.key + '" value="' + (s.value || '') + '">') +
            '</div>'
          ).join('') : ''}
        </div>
      </div>
      
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-envelope"></i><span>Contato</span></div>
        <div class="card-body">
          ${groupedSettings.contact ? groupedSettings.contact.map(s => 
            '<div class="form-group"><label>' + (s.label || s.key) + '</label><input type="text" name="' + s.key + '" value="' + (s.value || '') + '"></div>'
          ).join('') : ''}
        </div>
      </div>
      
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-share"></i><span>Redes Sociais</span></div>
        <div class="card-body">
          ${groupedSettings.social ? groupedSettings.social.map(s => 
            '<div class="form-group"><label>' + (s.label || s.key) + '</label><input type="url" name="' + s.key + '" value="' + (s.value || '') + '" placeholder="https://"></div>'
          ).join('') : ''}
        </div>
      </div>
      
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-file-text"></i><span>Posts</span></div>
        <div class="card-body">
          ${groupedSettings.posts ? groupedSettings.posts.map(s => 
            '<div class="form-group"><label>' + (s.label || s.key) + '</label><input type="number" name="' + s.key + '" value="' + (s.value || '') + '" min="1"></div>'
          ).join('') : ''}
        </div>
      </div>
      
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-layout-text-window"></i><span>Rodapé</span></div>
        <div class="card-body">
          ${groupedSettings.footer ? groupedSettings.footer.map(s => 
            '<div class="form-group"><label>' + (s.label || s.key) + '</label><textarea name="' + s.key + '" rows="2">' + (s.value || '') + '</textarea></div>'
          ).join('') : ''}
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== ABA APARÊNCIA ==================== -->
  <div class="tab-content" id="tab-aparencia">
    <div class="settings-grid">
      <!-- Layout do Header -->
      <div class="settings-card full-width">
        <div class="card-header"><i class="bi bi-layout-text-window-reverse"></i><span>Layout do Header</span></div>
        <div class="card-body">
          <div class="form-group">
            <label>Estilo do Header</label>
            <div class="header-style-options">
              <label class="header-style-option ${(groupedSettings.layout?.find(s => s.key === 'header_style')?.value || 'default') === 'default' ? 'active' : ''}">
                <input type="radio" name="header_style" value="default" ${(groupedSettings.layout?.find(s => s.key === 'header_style')?.value || 'default') === 'default' ? 'checked' : ''}>
                <div class="style-preview style-default"><div class="preview-topbar"></div><div class="preview-header"><div class="preview-logo"></div><div class="preview-search"></div></div></div>
                <span class="style-name">Padrão</span>
              </label>
              <label class="header-style-option ${(groupedSettings.layout?.find(s => s.key === 'header_style')?.value) === 'centered' ? 'active' : ''}">
                <input type="radio" name="header_style" value="centered" ${(groupedSettings.layout?.find(s => s.key === 'header_style')?.value) === 'centered' ? 'checked' : ''}>
                <div class="style-preview style-centered"><div class="preview-topbar"></div><div class="preview-header centered"><div class="preview-logo"></div></div></div>
                <span class="style-name">Centralizado</span>
              </label>
              <label class="header-style-option ${(groupedSettings.layout?.find(s => s.key === 'header_style')?.value) === 'minimal' ? 'active' : ''}">
                <input type="radio" name="header_style" value="minimal" ${(groupedSettings.layout?.find(s => s.key === 'header_style')?.value) === 'minimal' ? 'checked' : ''}>
                <div class="style-preview style-minimal"><div class="preview-header minimal"><div class="preview-logo"></div><div class="preview-menu-inline"><span></span><span></span></div></div></div>
                <span class="style-name">Minimalista</span>
              </label>
            </div>
          </div>
          
          <div class="form-row">
            <div class="form-group">
              <label>Tamanho da Logo</label>
              <div class="size-options">
                ${['30', '40', '50', '60'].map(size => '<label class="size-option ' + ((groupedSettings.layout?.find(s => s.key === 'logo_size')?.value || '40') === size ? 'active' : '') + '"><input type="radio" name="logo_size" value="' + size + '" ' + ((groupedSettings.layout?.find(s => s.key === 'logo_size')?.value || '40') === size ? 'checked' : '') + '><span>' + size + 'px</span></label>').join('')}
              </div>
            </div>
            <div class="form-group">
              <label>Tamanho da Fonte do Menu</label>
              <div class="size-options">
                ${['12', '14', '16', '18', '20'].map(size => '<label class="size-option ' + ((groupedSettings.layout?.find(s => s.key === 'menu_font_size')?.value || '14') === size ? 'active' : '') + '"><input type="radio" name="menu_font_size" value="' + size + '" ' + ((groupedSettings.layout?.find(s => s.key === 'menu_font_size')?.value || '14') === size ? 'checked' : '') + '><span>' + size + 'px</span></label>').join('')}
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <!-- Opções da Home -->
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-house-gear"></i><span>Opções da Home</span></div>
        <div class="card-body">
          <div class="toggle-item">
            <div class="toggle-info">
              <strong>Ocultar Categorias na Sidebar</strong>
              <small>Remove o widget de categorias</small>
            </div>
            <label class="switch">
              <input type="hidden" name="home_hide_categories" value="0">
              <input type="checkbox" name="home_hide_categories" value="1" ${groupedSettings.layout?.find(s => s.key === 'home_hide_categories')?.value === '1' ? 'checked' : ''}>
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </div>
      
      <!-- Favicon -->
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-app-indicator"></i><span>Favicon</span></div>
        <div class="card-body">
          <div class="form-group">
            <label>URL do Favicon</label>
            <input type="text" name="site_favicon" value="${groupedSettings.general?.find(s => s.key === 'site_favicon')?.value || '/images/favicon.ico'}" placeholder="/images/favicon.ico">
            <small>Ícone exibido na aba do navegador (formato .ico, .png ou .svg)</small>
          </div>
        </div>
      </div>
      
      <!-- Paleta de Cores -->
      <div class="settings-card full-width colors-card">
        <div class="card-header">
          <i class="bi bi-palette"></i><span>Paleta de Cores</span>
          <button type="button" class="btn-reset-colors" onclick="resetColors()"><i class="bi bi-arrow-counterclockwise"></i> Resetar</button>
        </div>
        <div class="card-body">
          <div class="color-sections">
            <div class="color-section">
              <h4>Cores Principais</h4>
              <div class="color-grid">
                <div class="color-item"><label>Primária</label><div class="color-input-wrapper"><input type="color" name="color_primary" value="${groupedSettings.colors?.find(s => s.key === 'color_primary')?.value || '#3b82f6'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_primary')?.value || '#3b82f6'}" class="color-text" data-for="color_primary"></div></div>
                <div class="color-item"><label>Primária Hover</label><div class="color-input-wrapper"><input type="color" name="color_primary_dark" value="${groupedSettings.colors?.find(s => s.key === 'color_primary_dark')?.value || '#2563eb'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_primary_dark')?.value || '#2563eb'}" class="color-text" data-for="color_primary_dark"></div></div>
                <div class="color-item"><label>Secundária</label><div class="color-input-wrapper"><input type="color" name="color_secondary" value="${groupedSettings.colors?.find(s => s.key === 'color_secondary')?.value || '#0f172a'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_secondary')?.value || '#0f172a'}" class="color-text" data-for="color_secondary"></div></div>
              </div>
            </div>
            <div class="color-section">
              <h4>Header</h4>
              <div class="color-grid">
                <div class="color-item"><label>Topbar BG</label><div class="color-input-wrapper"><input type="color" name="color_topbar_bg" value="${groupedSettings.colors?.find(s => s.key === 'color_topbar_bg')?.value || '#0f172a'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_topbar_bg')?.value || '#0f172a'}" class="color-text" data-for="color_topbar_bg"></div></div>
                <div class="color-item"><label>Topbar Texto</label><div class="color-input-wrapper"><input type="color" name="color_topbar_text" value="${groupedSettings.colors?.find(s => s.key === 'color_topbar_text')?.value || '#ffffff'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_topbar_text')?.value || '#ffffff'}" class="color-text" data-for="color_topbar_text"></div></div>
                <div class="color-item"><label>Header BG</label><div class="color-input-wrapper"><input type="color" name="color_header_bg" value="${groupedSettings.colors?.find(s => s.key === 'color_header_bg')?.value || '#ffffff'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_header_bg')?.value || '#ffffff'}" class="color-text" data-for="color_header_bg"></div></div>
                <div class="color-item"><label>Header Texto</label><div class="color-input-wrapper"><input type="color" name="color_header_text" value="${groupedSettings.colors?.find(s => s.key === 'color_header_text')?.value || '#0f172a'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_header_text')?.value || '#0f172a'}" class="color-text" data-for="color_header_text"></div></div>
              </div>
            </div>
            <div class="color-section">
              <h4>Menu</h4>
              <div class="color-grid">
                <div class="color-item"><label>Menu BG</label><div class="color-input-wrapper"><input type="color" name="color_menu_bg" value="${groupedSettings.colors?.find(s => s.key === 'color_menu_bg')?.value || '#ffffff'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_menu_bg')?.value || '#ffffff'}" class="color-text" data-for="color_menu_bg"></div></div>
                <div class="color-item"><label>Menu Texto</label><div class="color-input-wrapper"><input type="color" name="color_menu_text" value="${groupedSettings.colors?.find(s => s.key === 'color_menu_text')?.value || '#0f172a'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_menu_text')?.value || '#0f172a'}" class="color-text" data-for="color_menu_text"></div></div>
                <div class="color-item"><label>Menu Hover</label><div class="color-input-wrapper"><input type="color" name="color_menu_hover" value="${groupedSettings.colors?.find(s => s.key === 'color_menu_hover')?.value || '#3b82f6'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_menu_hover')?.value || '#3b82f6'}" class="color-text" data-for="color_menu_hover"></div></div>
              </div>
            </div>
            <div class="color-section">
              <h4>Corpo</h4>
              <div class="color-grid">
                <div class="color-item"><label>Fundo</label><div class="color-input-wrapper"><input type="color" name="color_body_bg" value="${groupedSettings.colors?.find(s => s.key === 'color_body_bg')?.value || '#f8fafc'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_body_bg')?.value || '#f8fafc'}" class="color-text" data-for="color_body_bg"></div></div>
                <div class="color-item"><label>Cards</label><div class="color-input-wrapper"><input type="color" name="color_card_bg" value="${groupedSettings.colors?.find(s => s.key === 'color_card_bg')?.value || '#ffffff'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_card_bg')?.value || '#ffffff'}" class="color-text" data-for="color_card_bg"></div></div>
                <div class="color-item"><label>Texto</label><div class="color-input-wrapper"><input type="color" name="color_text" value="${groupedSettings.colors?.find(s => s.key === 'color_text')?.value || '#0f172a'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_text')?.value || '#0f172a'}" class="color-text" data-for="color_text"></div></div>
                <div class="color-item"><label>Texto Muted</label><div class="color-input-wrapper"><input type="color" name="color_text_muted" value="${groupedSettings.colors?.find(s => s.key === 'color_text_muted')?.value || '#64748b'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_text_muted')?.value || '#64748b'}" class="color-text" data-for="color_text_muted"></div></div>
              </div>
            </div>
            <div class="color-section">
              <h4>Footer</h4>
              <div class="color-grid">
                <div class="color-item"><label>Footer BG</label><div class="color-input-wrapper"><input type="color" name="color_footer_bg" value="${groupedSettings.colors?.find(s => s.key === 'color_footer_bg')?.value || '#0f172a'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_footer_bg')?.value || '#0f172a'}" class="color-text" data-for="color_footer_bg"></div></div>
                <div class="color-item"><label>Footer Texto</label><div class="color-input-wrapper"><input type="color" name="color_footer_text" value="${groupedSettings.colors?.find(s => s.key === 'color_footer_text')?.value || '#94a3b8'}" class="color-picker"><input type="text" value="${groupedSettings.colors?.find(s => s.key === 'color_footer_text')?.value || '#94a3b8'}" class="color-text" data-for="color_footer_text"></div></div>
              </div>
            </div>
          </div>
          
          <div class="palettes-section">
            <h4>Paletas Prontas</h4>
            <div class="preset-palettes">
              <div class="palette-card" onclick="applyPalette('blue_white')"><div class="palette-colors"><span style="background:#3b82f6"></span><span style="background:#1e40af"></span><span style="background:#fff"></span></div><span>Azul</span></div>
              <div class="palette-card" onclick="applyPalette('green_white')"><div class="palette-colors"><span style="background:#10b981"></span><span style="background:#047857"></span><span style="background:#fff"></span></div><span>Verde</span></div>
              <div class="palette-card" onclick="applyPalette('orange_white')"><div class="palette-colors"><span style="background:#f97316"></span><span style="background:#c2410c"></span><span style="background:#fff"></span></div><span>Laranja</span></div>
              <div class="palette-card" onclick="applyPalette('red_white')"><div class="palette-colors"><span style="background:#ef4444"></span><span style="background:#b91c1c"></span><span style="background:#fff"></span></div><span>Vermelho</span></div>
              <div class="palette-card" onclick="applyPalette('purple_white')"><div class="palette-colors"><span style="background:#8b5cf6"></span><span style="background:#6d28d9"></span><span style="background:#fff"></span></div><span>Roxo</span></div>
              <div class="palette-card dark" onclick="applyPalette('dark_blue')"><div class="palette-colors"><span style="background:#60a5fa"></span><span style="background:#3b82f6"></span><span style="background:#0f172a"></span></div><span>Dark Azul</span></div>
              <div class="palette-card dark" onclick="applyPalette('dark_green')"><div class="palette-colors"><span style="background:#34d399"></span><span style="background:#10b981"></span><span style="background:#0f172a"></span></div><span>Dark Verde</span></div>
              <div class="palette-card dark" onclick="applyPalette('dark_purple')"><div class="palette-colors"><span style="background:#a78bfa"></span><span style="background:#8b5cf6"></span><span style="background:#0f172a"></span></div><span>Dark Roxo</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== ABA SEO ==================== -->
  <div class="tab-content" id="tab-seo">
    <div class="settings-grid">
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-google"></i><span>Google Search Console</span></div>
        <div class="card-body">
          <div class="form-group">
            <label>Código de Verificação</label>
            <input type="text" name="google_site_verification" value="${groupedSettings.seo?.find(s => s.key === 'google_site_verification')?.value || ''}" placeholder="Ex: abc123xyz...">
            <small>Cole apenas o código (sem a meta tag)</small>
          </div>
        </div>
      </div>
      
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-info-circle"></i><span>Informações</span></div>
        <div class="card-body">
          <div class="info-list">
            <div class="info-item"><span>Versão</span><span>1.0.0</span></div>
            <div class="info-item"><span>Node.js</span><span>${nodeVersion}</span></div>
            <div class="info-item"><span>Ambiente</span><span>${nodeEnv}</span></div>
          </div>
          <div class="quick-links">
            <a href="/" target="_blank"><i class="bi bi-eye"></i> Ver Site</a>
            <a href="/sitemap.xml" target="_blank"><i class="bi bi-diagram-3"></i> Sitemap</a>
            <a href="/robots.txt" target="_blank"><i class="bi bi-robot"></i> Robots.txt</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== ABA ANÚNCIOS ==================== -->
  <div class="tab-content" id="tab-anuncios">
    <div class="settings-grid">
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-house"></i><span>Anúncios na Home</span></div>
        <div class="card-body">
          <div class="form-group"><label>Topo</label><textarea name="ads_home_top" rows="3" placeholder="<!-- Código do anúncio -->">${groupedSettings.ads?.find(s => s.key === 'ads_home_top')?.value || ''}</textarea></div>
          <div class="form-group"><label>Meio</label><textarea name="ads_home_middle" rows="3" placeholder="<!-- Código do anúncio -->">${groupedSettings.ads?.find(s => s.key === 'ads_home_middle')?.value || ''}</textarea></div>
          <div class="form-group"><label>Rodapé</label><textarea name="ads_home_bottom" rows="3" placeholder="<!-- Código do anúncio -->">${groupedSettings.ads?.find(s => s.key === 'ads_home_bottom')?.value || ''}</textarea></div>
          <div class="form-group"><label>Sidebar</label><textarea name="ads_home_sidebar" rows="3" placeholder="<!-- Código do anúncio -->">${groupedSettings.ads?.find(s => s.key === 'ads_home_sidebar')?.value || ''}</textarea></div>
        </div>
      </div>
      
      <div class="settings-card">
        <div class="card-header"><i class="bi bi-file-text"></i><span>Anúncios nas Postagens</span></div>
        <div class="card-body">
          <div class="form-group"><label>Topo</label><textarea name="ads_post_top" rows="3" placeholder="<!-- Código do anúncio -->">${groupedSettings.ads?.find(s => s.key === 'ads_post_top')?.value || ''}</textarea></div>
          <div class="form-group"><label>Meio</label><textarea name="ads_post_middle" rows="3" placeholder="<!-- Código do anúncio -->">${groupedSettings.ads?.find(s => s.key === 'ads_post_middle')?.value || ''}</textarea></div>
          <div class="form-group"><label>Rodapé</label><textarea name="ads_post_bottom" rows="3" placeholder="<!-- Código do anúncio -->">${groupedSettings.ads?.find(s => s.key === 'ads_post_bottom')?.value || ''}</textarea></div>
          <div class="form-group"><label>Sidebar</label><textarea name="ads_post_sidebar" rows="3" placeholder="<!-- Código do anúncio -->">${groupedSettings.ads?.find(s => s.key === 'ads_post_sidebar')?.value || ''}</textarea></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== ABA CÓDIGO ==================== -->
  <div class="tab-content" id="tab-codigo">
    <div class="settings-grid">
      <div class="settings-card full-width code-card">
        <div class="card-header"><i class="bi bi-code-slash"></i><span>Injeção de Código</span></div>
        <div class="card-body">
          <p class="code-description">Adicione código personalizado. Útil para Google Analytics, pixels de rastreamento, etc.</p>
          <div class="form-group">
            <label><i class="bi bi-chevron-double-up"></i> Código no &lt;head&gt;</label>
            <textarea name="code_head" rows="5" class="code-textarea" placeholder="<!-- Scripts, meta tags, etc -->">${groupedSettings.code_injection?.find(s => s.key === 'code_head')?.value || ''}</textarea>
